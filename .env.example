# n8n-hubspot-meeting-no-show-re-engagement-pipeline
# DISCLAIMER.md · Licensed under the MIT License. License: MIT © 2026 dhRobin Systems · Provided as-is, see the disclaimer.
#
# Copy to .env for the CLI, or set the same variables in the n8n environment.
# Every value is a placeholder or a safe default. Never commit real values.

# --- HubSpot ------------------------------------------------------------------------
# Private app token. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.objects.owners.read, plus meeting read and task write permissions, plus automation
# (sequences) only if EMAIL_PROVIDER=hubspot_sequence. While this stays a placeholder the
# workflow runs in demo mode: fictional records, mock services, no network calls.
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional: a portal ID that SANDBOX_MODE accepts even if its account type is not SANDBOX/DEVELOPER_TEST.
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID
# Meeting outcome values that count as a no-show (internal values, comma-separated).
NO_SHOW_OUTCOME_VALUES=NO_SHOW

# --- Safety switches (fail safe: only false/0/no/off turns them off) --------------------
# DRY_RUN=true: decide everything, write nothing, send nothing.
DRY_RUN=true
# SANDBOX_MODE=true: refuse production portals; SMS only to SMS_SANDBOX_RECIPIENT.
SANDBOX_MODE=true

# --- Webhook authentication -----------------------------------------------------------------
# Shared secret sent by the HubSpot meeting workflow in WEBHOOK_SECRET_HEADER (24+ random characters).
WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
WEBHOOK_SECRET_HEADER=x-webhook-secret
# Signing key returned when you create the Calendly webhook subscription.
CALENDLY_WEBHOOK_SIGNING_KEY=YOUR_CALENDAR_WEBHOOK_SECRET
WEBHOOK_MAX_AGE_MINUTES=5
MAX_EVENTS_PER_REQUEST=50
EVENT_DEDUPE_DAYS=7

# --- Calendly API (resolves invitee emails when a no-show payload only carries the invitee URI) ---
CALENDLY_API_TOKEN=YOUR_CALENDLY_PERSONAL_ACCESS_TOKEN
CALENDLY_BASE_URL=https://api.calendly.com

# --- Deal stage update ------------------------------------------------------------------------
# JSON map of pipeline ID to the stage ID deals move to after a no-show.
NO_SHOW_DEAL_STAGE_MAP={"default":"YOUR_NO_SHOW_DEAL_STAGE_ID"}
# most_recent (newest open deal) | all (every open associated deal)
DEAL_SELECTION=most_recent
# false: a deal already past the no-show stage is never moved backwards.
ALLOW_BACKWARD_STAGE_MOVES=false
MAX_DEALS_PER_EVENT=10

# --- Re-engagement router -----------------------------------------------------------------------
# Channel order tried for each contact (sms, email).
CHANNEL_PRIORITY=sms,email
SEND_BOTH_CHANNELS=false
REENGAGEMENT_COOLDOWN_DAYS=7
# Contact property that must be "true" before any SMS is sent.
SMS_CONSENT_PROPERTY=sms_marketing_consent
EMAIL_OPT_OUT_PROPERTY=hs_email_optout
REBOOKING_URL=YOUR_REBOOKING_URL

# --- Email channel ----------------------------------------------------------------------------------
# hubspot_workflow: the contact stamp "email_triggered" enrols the contact in a HubSpot email workflow.
# hubspot_sequence: enrol the contact in HUBSPOT_SEQUENCE_ID on behalf of the meeting owner.
# none: no automated email.
EMAIL_PROVIDER=hubspot_workflow
HUBSPOT_SEQUENCE_ID=YOUR_HUBSPOT_SEQUENCE_ID

# --- SMS channel (Twilio) ---------------------------------------------------------------------------
# none (default) | twilio
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# Either a sending number (E.164) or a Messaging Service SID.
TWILIO_FROM_NUMBER=YOUR_TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=YOUR_TWILIO_MESSAGING_SERVICE_SID
TWILIO_BASE_URL=https://api.twilio.com
# In SANDBOX_MODE every SMS goes to this test number (E.164) instead of the contact.
SMS_SANDBOX_RECIPIENT=YOUR_SMS_SANDBOX_RECIPIENT
SMS_TIMEZONE=America/New_York
SMS_ALLOWED_HOURS=9-20
SMS_DEFAULT_COUNTRY_CODE=1
SMS_TEMPLATE=Hi {{firstName}}, sorry we missed each other today. Pick a new time that suits you: {{rebookUrl}} Reply STOP to opt out.

# --- Contact stamp properties (created by npm run properties:create) ------------------------------
REENGAGEMENT_STATUS_PROPERTY=no_show_reengagement_status
REENGAGEMENT_TIMESTAMP_PROPERTY=no_show_last_reengaged_at
NO_SHOW_COUNT_PROPERTY=no_show_count
PROPERTY_GROUP_NAME=contactinformation

# --- Rep follow-up task ---------------------------------------------------------------------------
CREATE_REP_TASKS=true
TASK_DUE_HOURS=2
# Owner ID used when neither the meeting, deal nor contact has an owner.
FALLBACK_TASK_OWNER_ID=YOUR_FALLBACK_OWNER_ID

# --- Failure alerts (optional HTTPS endpoint, for example a Slack incoming webhook) -----------------
ALERT_WEBHOOK_URL=YOUR_ALERT_WEBHOOK_URL

# --- Manual runs in HubSpot mode --------------------------------------------------------------------
MANUAL_TEST_MEETING_IDS=YOUR_SANDBOX_MEETING_IDS

# --- Testing only ----------------------------------------------------------------------------------
# Pins the clock (ISO 8601). Leave empty in production.
PIPELINE_NOW=

# --- n8n host settings (set on the n8n instance) ----------------------------------------------------
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false   lets Code nodes and expressions read $env
# NODE_FUNCTION_ALLOW_BUILTIN=crypto   lets the intake node verify Calendly signatures
